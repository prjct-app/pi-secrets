{
  "name": "@prjct.app/pi-secrets",
  "version": "0.2.6",
  "description": "OS keychain credentials and local outbound privacy guardrails for Pi: confirm, obfuscate or cancel sensitive data before a model request.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "ai-coding",
    "developer-tools",
    "secrets",
    "api-keys",
    "keychain",
    "redaction"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-secrets/main/docs/cover.png"
  },
  "scripts": {
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "! grep -rn '\\blet\\b' src/ || (echo 'Use immutable values: no let bindings in src/' && exit 1)",
    "test": "node --import ./tests/isolate.mjs --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@prjct.app/pi-tui-kit": "^0.3.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "piBuild": {
    "external": [
      "@napi-rs/keyring"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-secrets.git"
  },
  "homepage": "https://github.com/prjct-app/pi-secrets#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-secrets/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/cover.png"
  ],
  "exports": {
    ".": "./index.ts",
    "./privacy": "./src/privacy.ts"
  }
}
